<div class="editApiPage">
  <h1 class="editApiPage__title"><%= title %></h1>

  <% if (errors && errors.length > 0) { %>
		<ul class="addPiPage__errorList">
			<% errors.forEach(error => { %>
				<li class="editApiPage__errorList_error"><%= error %></li>
			<% }) %>
		</ul>
	<% } %>

	<form action="/dashboard/edit/<%= formData.id %>" method="post" class="editApiPage__form">
		<label for="name" class="editApiPage__form_label">API Name</label>
		<input
			class="editApiPage__form_input"
			type="text"
			id="name"
			name="name"
			placeholder="e.g. Weather API"
			value="<%= formData.name || '' %>"
			required
		>

		<label for="baseUrl" class="editApiPage__form_label">Base URL</label>
		<input
			class="editApiPage__form_input"
			type="text"
			id="baseUrl"
			name="baseUrl"
			placeholder="https://api.example.com"
			value="<%= formData.baseUrl || '' %>"
			required
		>

		<label class="editApiPage__form_label" for="status">Status</label>
    <select class="editApiPage__form_select" id="status" name="status">
      <option value="active" <%= formData.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= formData.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
    </select>

		<label class="editApiPage__form_label" for="whitelist">Whitelist Domains (comma separated)</label>
    <textarea
			class="editApiPage__form_textarea"
			id="whitelist"
			name="whitelist"
			rows="3"
			placeholder="https://example.com, https://myapp.net"
		><%= formData.whitelist || '' %></textarea>

		<button class="editApiPage__form_btn" type="submit" class="btn-primary">Edit API</button>
	</form>
</div>
